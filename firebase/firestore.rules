rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Mutations and scoped reads pass through the authenticated callable API.
  // No client may assign itself a role or change a House association.
  match /users/{uid} { allow get: if request.auth != null && request.auth.uid == uid; }
  match /{document=**} { allow read, write: if false; }
 }
}
