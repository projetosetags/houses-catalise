rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
  function active() { return request.auth != null && profile().active == true; }
  function house(h) { return firestore.get(/databases/(default)/documents/houses/$(h)).data; }
  function accessHouse(h) {
   return active() && house(h).active == true && (profile().role == 'admin' || (profile().role == 'leader' && h in profile().house_ids) || (profile().role == 'pastor' && house(h).network_id in profile().network_ids));
  }
  match /meetings/{houseId}/{meetingDate}/photo.jpg {
   allow get: if accessHouse(houseId);
   allow create, update: if accessHouse(houseId) && meetingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
  }
  match /materials/{week}/{materialId}/{filename} {
   function material() { return firestore.get(/databases/(default)/documents/materials/$(materialId)).data; }
   function targeted() { return (material().house_id == null && (material().network_id == null || material().network_id in profile().network_ids)) || (material().house_id != null && ((profile().role == 'leader' && material().house_id in profile().house_ids) || (profile().role == 'pastor' && material().network_id in profile().network_ids)));  }
   allow get: if active() && material().active == true && material().storage_path == 'materials/' + week + '/' + materialId + '/' + filename && (profile().role == 'admin' || (material().ready == true && targeted()));
   allow create, update: if active() && profile().role == 'admin' && material().active == true && material().storage_path == 'materials/' + week + '/' + materialId + '/' + filename && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType == material().mime_type && request.resource.contentType in ['application/pdf','image/jpeg','image/png'];
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
